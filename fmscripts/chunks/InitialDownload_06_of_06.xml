<Step enable="True" id="28" name="Perform Find"><DisableStepCollapsed state="False"/><Restore state="True"/><Query><RequestRow operation="Include"><Criteria><Field table="CUSTOMER_EQUIPMENT" id="75" name="__ID"/><Text>$staleID</Text></Criteria></RequestRow></Query></Step>
