<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Script includeInMenu="True" SiriShortcutVisible="False" runFullAccess="True" id="0" name="zProbe - First Setup">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Install probe. Offline SANDBOX copy only. Safe to delete.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Generated by scripts/generate-probe-install.js. Runs with full access:</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Add Account, Enable Account and Delete Account require it.</Text></Step>
<Step enable="True" id="86" name="Set Error Capture"><Set state="True"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="85" name="Allow User Abort"><Set state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[not inSandbox]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Sandbox only"]]></Calculation></Title><Message><Calculation><![CDATA[Get ( FileName ) & " is not a Sandbox copy."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[If ( IsEmpty ( Get ( ScriptParameter ) ) ; "zprobe_tech" ; Get ( ScriptParameter ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$account</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$account = "zprobe_tech"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$testMode</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( AccountName )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$startedAs</Name></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------ASK FOR A PASSWORD---------- #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Typed once, into a global that is cleared straight after. The password</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>never travels: it is not in the URL and not read from any table.</Text></Step>
<Step enable="True" id="147" name="Set Field By Name"><DisableStepCollapsed state="False"/><Result><Calculation><![CDATA[""]]></Calculation></Result><TargetName><Calculation><![CDATA["Sync_Settings::zg_SetupPassword"]]></Calculation></TargetName></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Set up this iPad"]]></Calculation></Title><Message><Calculation><![CDATA["Account: " & $account & ¶ & ¶ & "Choose the password you will use to open the field app on this iPad." & If ( $testMode ; ¶ & ¶ & "(Test mode -- this account is deleted again at the end.)" ; "" )]]></Calculation></Message><Buttons><Button CommitState="True"><Calculation><![CDATA["Create Account"]]></Calculation></Button><Button CommitState="False"><Calculation><![CDATA["Cancel"]]></Calculation></Button><Button CommitState="False"/></Buttons><InputFields><InputField UsePasswordCharacter="True"><Field table="Sync_Settings" id="0" name="zg_SetupPassword"/><Label><Calculation><![CDATA["Password"]]></Calculation></Label></InputField><InputField UsePasswordCharacter="False"><Field table="" id="0" name=""/></InputField><InputField UsePasswordCharacter="False"><Field table="" id="0" name=""/></InputField></InputFields></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastMessageChoice )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$choice</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Sync_Settings::zg_SetupPassword]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$pw</Name></Step>
<Step enable="True" id="147" name="Set Field By Name"><DisableStepCollapsed state="False"/><Result><Calculation><![CDATA[""]]></Calculation></Result><TargetName><Calculation><![CDATA["Sync_Settings::zg_SetupPassword"]]></Calculation></TargetName></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$choice ≠ 1 or IsEmpty ( $pw )]]></Calculation></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "{}" ; "cancelled" ; True ; JSONBoolean )]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------CREATE, SWITCH OFF GUEST, SIGN IN AS THE NEW ACCOUNT---------- #</Text></Step>
<Step enable="True" id="134" name="Add Account"><DisableStepCollapsed state="False"/><ChgPwdOnNextLogin value="False"/><AccountName><Calculation><![CDATA[$account]]></Calculation></AccountName><Password><Calculation><![CDATA[$pw]]></Calculation></Password><PrivilegeSet id="2" name="[Data Entry Only]"/><AddAccount><AccountType>FileMaker</AccountType></AddAccount></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$addError</Name></Step>
<Step enable="True" id="137" name="Enable Account"><DisableStepCollapsed state="False"/><AccountOperation value="Deactivate"/><AccountName><Calculation><![CDATA["[Guest]"]]></Calculation></AccountName></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$guestOffError</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$testMode]]></Calculation></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Test mode puts [Guest] back. The real setup leaves it off, so the next</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>launch asks for the tech's account.</Text></Step>
<Step enable="True" id="137" name="Enable Account"><DisableStepCollapsed state="False"/><AccountOperation value="Activate"/><AccountName><Calculation><![CDATA["[Guest]"]]></Calculation></AccountName></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$guestOnError</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="138" name="Re-Login"><NoInteract state="True"/><DisableStepCollapsed state="False"/><AccountName><Calculation><![CDATA[$account]]></Calculation></AccountName><Password><Calculation><![CDATA[$pw]]></Calculation></Password></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$reloginError</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[""]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$pw</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( AccountName )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$nowAs</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( AccountPrivilegeSetName )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$nowSet</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
  [ "device" ; Get ( ApplicationVersion ) ; JSONString ] ;
  [ "file" ; Get ( FileName ) ; JSONString ] ;
  [ "filePath" ; Get ( FilePath ) ; JSONString ] ;
  [ "hosted" ; Left ( Get ( FilePath ) ; 6 ) = "fmnet:" ; JSONBoolean ] ;
  [ "startedAs" ; $startedAs ; JSONString ] ;
  [ "account" ; $account ; JSONString ] ;
  [ "testMode" ; $testMode ; JSONBoolean ] ;
  [ "addError" ; $addError ; JSONNumber ] ;
  [ "guestOffError" ; $guestOffError ; JSONNumber ] ;
  [ "guestOnError" ; If ( $testMode ; $guestOnError ; "left off" ) ; JSONString ] ;
  [ "reloginError" ; $reloginError ; JSONNumber ] ;
  [ "nowSignedInAs" ; $nowAs ; JSONString ] ;
  [ "privilegeSet" ; $nowSet ; JSONString ]
)]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$report</Name></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["First Setup probe"]]></Calculation></Title><Message><Calculation><![CDATA[JSONFormatElements ( $report )]]></Calculation></Message></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------TEST MODE: SIGN BACK IN AS ADMIN, REMOVE THE TEST ACCOUNT---------- #</Text></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$testMode and $addError = 0]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Sign back in"]]></Calculation></Title><Message><Calculation><![CDATA["Next, FileMaker asks you to sign in. Use the Admin account, so the probe can delete zprobe_tech."]]></Calculation></Message></Step>
<Step enable="True" id="138" name="Re-Login"><NoInteract state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( AccountName )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$backAs</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$backAs ≠ "zprobe_tech"]]></Calculation></Step>
<Step enable="True" id="135" name="Delete Account"><DisableStepCollapsed state="False"/><AccountName><Calculation><![CDATA["zprobe_tech"]]></Calculation></AccountName></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$deleteError</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Cleanup"]]></Calculation></Title><Message><Calculation><![CDATA["Signed back in as: " & $backAs & ¶ & "Delete zprobe_tech: " & If ( IsEmpty ( $deleteError ) ; "not attempted -- still signed in as it" ; "error " & $deleteError )]]></Calculation></Message></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[$report]]></Calculation></Step>
</Script>
</fmxmlsnippet>