<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[IsEmpty ( $html ) or $html = "data:text/html,"]]></Calculation></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Nothing has been deployed under this widget name yet.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["The field app hasn't been deployed into this file yet (no HTML record named " & $widgetName & ")."]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$error</Name></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "{}" ; [ "error" ; $error ; JSONString ] )]]></Calculation></Step>
