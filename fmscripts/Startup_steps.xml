<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Description: Runs on file open. Loads the field app into the web viewer.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Set this as the OnFirstWindowOpen trigger in File > File Options ></Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Script Triggers -- that setting cannot be pasted in.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>#################### #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Generated by scripts/generate-startup.js -- edit that, not this.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>#################### #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------INITIALIZE---------- #</Text></Step>
<Step enable="True" id="86" name="Set Error Capture"><Set state="True"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="85" name="Allow User Abort"><Set state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["web"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$webViewerName</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["GasketsRockField"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$appName</Name></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------SIGNED IN AS GUEST?---------- #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Every copy opens as [Guest] (File Options -> Log in using Guest account).</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Before First Setup that is how the Download button's URL gets in; after it,</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>the tech signs in with their own account. FileMaker would not deactivate</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>[Guest] from a script (Enable Account: error 212, local or hosted), so the</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>switch happens here instead. Startup runs with full access so it can read</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Sync_Settings while still signed in as Guest.</Text></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( AccountName ) = "[Guest]"]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[GetAsNumber ( ExecuteSQL ( "select \"Initialized\" from \"Sync_Settings\"" ; "" ; "" ) ) = 1]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$setUp</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[not $setUp]]></Calculation></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Not set up: exit quietly. On an install, the Download button's URL opens the</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>copy and First Setup runs straight after this trigger -- a dialog here would</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>tell the tech to do what they are already doing. A script cannot see that a</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>URL script is queued, so no message either way.</Text></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>FileMaker's own sign-in dialog; FileMaker Go can keep the password in the keychain.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[0]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$try</Name></Step>
<Step enable="True" id="71" name="Loop"><DisableStepCollapsed state="False"/><Restore state="False"/><FlushType value="Always"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$try + 1]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$try</Name></Step>
<Step enable="True" id="138" name="Re-Login"><NoInteract state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="72" name="Exit Loop If"><DisableStepCollapsed state="False"/><Calculation><![CDATA[Get ( AccountName ) ≠ "[Guest]" or $try ≥ 3]]></Calculation></Step>
<Step enable="True" id="73" name="End Loop"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( AccountName ) = "[Guest]"]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Sign in needed"]]></Calculation></Title><Message><Calculation><![CDATA["Sign in with your own account to use the field app. Close the file and open it again to try again."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------RESOLVE THE WIDGET SOURCE---------- #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>The widget comes from the HTML table, the house home for web viewer</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>code: npm run deploy-to-fm runs UploadToHTML, which writes the inlined</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>build into the record whose Name matches widget.config.js.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>There is deliberately no $$Dev / localhost branch here. Loading the</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>parcel dev server into the web viewer is a developer convenience that</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>has no business running on a field device; develop in a browser and</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>deploy to test the real thing.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[ExecuteSQL ( "select \"HTML\" from \"HTML\" where \"Name\" = ?" ; "" ; "" ; $appName )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$stored</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[IsEmpty ( $stored )]]></Calculation></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Nothing deployed under this app name. Say so rather than loading an</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>empty data: URL and leaving the tech at a blank screen.</Text></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Field app not installed"]]></Calculation></Title><Message><Calculation><![CDATA["No deployed copy of the field app was found in this file (HTML record \"" & $appName & "\"). Deploy it before using this device offline."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "{}" ; [ "error" ; "no deployed widget" ; JSONString ] )]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>FileMaker Pro: base64 data URL. Hand-escaping the raw HTML does not survive</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>the round trip: encoding % corrupts the modulo operator in the bundle and the</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>nested SVG data URI in the CSS, and a raw # cuts the document off.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>FileMaker Go: a file in the temp folder. Go renders no base64 data URL at</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>all, and does not decode %-escapes in a plain one (# as %23 reached the</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>page literally and broke every selector) -- zTest - Web Viewer, 2026-10-15,</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Go 26.0.3. Written fresh on every open; the temp folder is per session.</Text></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( SystemPlatform ) = 3]]></Calculation></Step>
<Step enable="True" id="147" name="Set Field By Name"><DisableStepCollapsed state="False"/><Result><Calculation><![CDATA[TextEncode ( $stored ; "utf-8" ; 1 )]]></Calculation></Result><TargetName><Calculation><![CDATA["Sync_Settings::zg_RouteFile"]]></Calculation></TargetName></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( TemporaryPath ) & "widget.html"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$widgetPath</Name></Step>
<Step enable="True" id="132" name="Export Field Contents"><CreateDirectories state="False"/><DisableStepCollapsed state="False"/><AutoOpen state="False"/><CreateEmail state="False"/><UniversalPathList>$widgetPath</UniversalPathList><Field table="Sync_Settings" id="36" name="zg_RouteFile"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$widgetError</Name></Step>
<Step enable="True" id="147" name="Set Field By Name"><DisableStepCollapsed state="False"/><Result><Calculation><![CDATA[""]]></Calculation></Result><TargetName><Calculation><![CDATA["Sync_Settings::zg_RouteFile"]]></Calculation></TargetName></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$widgetError ≠ 0]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Field app could not start"]]></Calculation></Title><Message><Calculation><![CDATA["Could not prepare the field app on this iPad (error " & $widgetError & "). Close the file and open it again."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "{}" ; [ "error" ; "widget file " & $widgetError ; JSONString ] )]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["file://" & $widgetPath]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$html</Name></Step>
<Step enable="True" id="69" name="Else"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["data:text/html;base64," & Base64EncodeRFC ( 4648 ; $stored )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$html</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------RENDER---------- #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Open on the field interface regardless of where the file was last left.</Text></Step>
<Step enable="True" id="6" name="Go to Layout"><DisableStepCollapsed state="False"/><LayoutDestination value="SelectedLayout"/><Layout id="19" name="Home"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Blanking the URL first forces a reload even when it has not changed.</Text></Step>
<Step enable="True" id="146" name="Set Web Viewer"><DisableStepCollapsed state="False"/><Action value="GoToURL"/><ObjectName><Calculation><![CDATA[$webViewerName]]></Calculation></ObjectName><URL custom="False"><Calculation><![CDATA[""]]></Calculation></URL></Step>
<Step enable="True" id="146" name="Set Web Viewer"><DisableStepCollapsed state="False"/><Action value="GoToURL"/><ObjectName><Calculation><![CDATA[$webViewerName]]></Calculation></ObjectName><URL custom="False"><Calculation><![CDATA[$html]]></Calculation></URL></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>No data is pushed here. The widget calls GetLocationList itself once it</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>is running, which is what reports whether a download is needed and how</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>many edits are waiting to upload -- so that state reaches the tech in</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>the interface rather than in a dialog they dismiss before reading.</Text></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
</fmxmlsnippet>