<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Script includeInMenu="True" SiriShortcutVisible="False" runFullAccess="False" id="0" name="zProbe - Download Offline App">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Install probe for the live SANDBOX file. Run in FileMaker Go while signed in.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Generated by scripts/generate-probe-install.js. Safe to delete.</Text></Step>
<Step enable="True" id="86" name="Set Error Capture"><Set state="True"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="85" name="Allow User Abort"><Set state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>The master already has an Admin account, so Add Account cannot create it</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>(run 1: error 12, then Re-Login 212). Signed in here as Admin, send a</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>throwaway name instead so the probe can still prove Add Account + Re-Login.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[If ( Get ( AccountName ) = "Admin" ; "zprobe_ipad" ; Get ( AccountName ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$account</Name></Step>
<Step enable="True" id="6" name="Go to Layout"><DisableStepCollapsed state="False"/><LayoutDestination value="SelectedLayout"/><Layout id="0" name="OfflineApp"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$layoutError</Name></Step>
<Step enable="True" id="23" name="Show All Records"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( FoundCount )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$found</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[GetContainerAttribute ( OfflineApp::File ; "filesize" )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$size</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$layoutError ≠ 0 or $found = 0 or IsEmpty ( OfflineApp::File )]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Nothing to download"]]></Calculation></Title><Message><Calculation><![CDATA["Needs an OfflineApp layout with a record whose File holds the offline sandbox copy. Layout error " & $layoutError & ", records " & $found & "."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( DocumentsPath ) & "GasketsRockOffline_SandboxInstall.fmp12"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$path</Name></Step>
<Step enable="True" id="132" name="Export Field Contents"><CreateDirectories state="False"/><DisableStepCollapsed state="False"/><AutoOpen state="False"/><CreateEmail state="False"/><UniversalPathList>$path</UniversalPathList><Field table="OfflineApp" id="0" name="File"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$exportError</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["fmp://~/GasketsRockOffline_SandboxInstall.fmp12?script=" & GetAsURLEncoded ( "zProbe - First Setup" ) & "&param=" & GetAsURLEncoded ( $account )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$url</Name></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Download probe"]]></Calculation></Title><Message><Calculation><![CDATA[JSONFormatElements ( JSONSetElement ( "{}" ;
  [ "device" ; Get ( ApplicationVersion ) ; JSONString ] ;
  [ "account" ; $account ; JSONString ] ;
  [ "fileSize" ; $size ; JSONNumber ] ;
  [ "path" ; $path ; JSONString ] ;
  [ "exportError" ; $exportError ; JSONNumber ] ;
  [ "url" ; $url ; JSONString ]
) ) & ¶ & ¶ & If ( $exportError = 0 ; "OK opens it and runs First Setup." ; "Export failed -- not opening." )]]></Calculation></Message></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$exportError = 0]]></Calculation></Step>
<Step enable="True" id="111" name="Open URL"><NoInteract state="True"/><Option state="False"/><DisableStepCollapsed state="False"/><Calculation><![CDATA[$url]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
</Script>
</fmxmlsnippet>