<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( TotalRecordCount )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$after</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Profiles::__kp_Gasket_Profile & " | " & Profiles::Profile_Description & " | " & Profiles::Profile_Dimensions]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$sample</Name></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------4. REMOVE EXACTLY WHAT WAS ADDED---------- #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>After an import the found set is the imported rows. Delete only when the</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>counts prove that -- a failed import leaves the old found set in place.</Text></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$importError = 0 and $imported > 0 and $after = $before + $imported]]></Calculation></Step>
<Step enable="True" id="10" name="Delete All Records"><NoInteract state="True"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["removed the " & $imported & " imported rows; " & Get ( TotalRecordCount ) & " left"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$cleanup</Name></Step>
<Step enable="True" id="69" name="Else"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["nothing deleted -- counts did not line up"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$cleanup</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="147" name="Set Field By Name"><DisableStepCollapsed state="False"/><Result><Calculation><![CDATA[""]]></Calculation></Result><TargetName><Calculation><![CDATA["Sync_Settings::zg_RouteFile"]]></Calculation></TargetName></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["done"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$stage</Name></Step>
