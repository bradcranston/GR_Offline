<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>----------READY TO DISTRIBUTE?---------- #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>A copy without either of these is useless to a tech, and they would only</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>find out in the field.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"Credential\" where \"Name\" = 'odata' and \"Value\" is not null" ; "" ; "" ) ) ) > 0]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$hasCredential</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"HTML\" where \"Name\" = ? and \"HTML\" is not null" ; "" ; "" ; "GasketsRockField" ) ) ) > 0]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$hasWidget</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"Locations\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"CUSTOMER_EQUIPMENT\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"Address\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"CONj__ContactsJoin\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"CON_Contacts\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"ContactMethod\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"MFG_Manufacturers\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"Profiles\"" ; "" ; "" ) ) ) + Max ( 0 ; GetAsNumber ( ExecuteSQL ( "select count(*) from \"Sync_Settings\"" ; "" ; "" ) ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$left</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[List ( If ( not $hasCredential ; "No odata row in Credential -- this copy cannot download." ) ; If ( not $hasWidget ; "No GasketsRockField record in HTML -- this copy will open to 'Field app not installed'." ) ; If ( $left > 0 ; $left & " record(s) are still in the data tables." ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$warnings</Name></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA[If ( IsEmpty ( $failed ) and IsEmpty ( $warnings ) ; "Ready to distribute" ; "Not ready to distribute" )]]></Calculation></Title><Message><Calculation><![CDATA[If ( IsEmpty ( $failed ) ; "All route data cleared." ; "Could not clear:" & ¶ & $failed ) & If ( not IsEmpty ( $warnings ) ; ¶ & ¶ & $warnings ; ¶ & ¶ & "Close the file and copy it for each tech. Each copy runs Initial Download for its own route." )]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "{}" ; [ "ready" ; IsEmpty ( $failed ) and IsEmpty ( $warnings ) ; JSONBoolean ] ; [ "failed" ; $failed ; JSONString ] ; [ "warnings" ; $warnings ; JSONString ] )]]></Calculation></Step>
