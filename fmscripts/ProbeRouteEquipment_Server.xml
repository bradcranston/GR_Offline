<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[GetNthRecord ( customers_locations__CUSTOMERS_EQUIPMENT::Item_Note ; $r )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$note</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[PatternCount ( $note ; Char ( 13 ) ) > 0 and $withBreak < 2]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$isBreak</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[PatternCount ( $note ; Char ( 34 ) ) > 0 and $withQuote < 2 and not $isBreak]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$isQuote</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$isBreak or $isQuote]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[JSONSetElement ( $samples ; "[" & ValueCount ( JSONListKeys ( $samples ; "" ) ) & "]" ; JSONSetElement ( "{}" ; [ "__ID" ; GetNthRecord ( customers_locations__CUSTOMERS_EQUIPMENT::__ID ; $r ) ; JSONString ] ; [ "Item_Note" ; $note ; JSONString ] ) ; JSONObject )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$samples</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$withBreak + If ( $isBreak ; 1 ; 0 )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$withBreak</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$withQuote + If ( $isQuote ; 1 ; 0 )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$withQuote</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
