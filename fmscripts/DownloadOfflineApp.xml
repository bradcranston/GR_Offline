<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="0" name="Download Offline App">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Description: Installs the offline field app on this iPad for the signed-in user.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Run from the Download offline app button in GasketsRock.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>#################### #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Generated by scripts/generate-download-offline-app.js -- edit that, not this.</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>#################### #</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="86" name="Set Error Capture"><Set state="True"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="85" name="Allow User Abort"><Set state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( AccountName )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$account</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[not IsEmpty ( FilterValues ( Lower ( $account ) ; "admin¶[guest]" ) )]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Use your own account"]]></Calculation></Title><Message><Calculation><![CDATA["The field app is set up for the person signed in. Sign in to Gaskets Rock with your own account, not " & $account & ", and try again."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Which copy: the one for this file's environment, so a sandbox copy can</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>never be installed from production or the other way round.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[If ( PatternCount ( Get ( FileName ) ; "Sandbox" ) ; "GasketsRockOffline_Sandbox" ; "GasketsRockOffline" )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$name</Name></Step>
<Step enable="True" id="6" name="Go to Layout"><DisableStepCollapsed state="False"/><LayoutDestination value="SelectedLayout"/><Layout id="342" name="OfflineApp"/></Step>
<Step enable="True" id="22" name="Enter Find Mode"><DisableStepCollapsed state="False"/><Pause state="False"/><Restore state="False"/></Step>
<Step enable="True" id="147" name="Set Field By Name"><DisableStepCollapsed state="False"/><Result><Calculation><![CDATA["==" & $name]]></Calculation></Result><TargetName><Calculation><![CDATA["OfflineApp::Name"]]></Calculation></TargetName></Step>
<Step enable="True" id="28" name="Perform Find"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( LastError ) ≠ 0 or IsEmpty ( OfflineApp::File )]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Not available"]]></Calculation></Title><Message><Calculation><![CDATA["The field app (" & $name & ") hasn't been uploaded yet. Ask the office."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Download the field app"]]></Calculation></Title><Message><Calculation><![CDATA["This installs the field app on this iPad for " & $account & " and downloads your route." & ¶ & ¶ & "If the field app is already on this iPad it will be replaced -- upload any changes you haven't sent first."]]></Calculation></Message><Buttons><Button CommitState="False"><Calculation><![CDATA["Cancel"]]></Calculation></Button><Button CommitState="False"><Calculation><![CDATA["Download"]]></Calculation></Button><Button CommitState="False"/></Buttons></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( LastMessageChoice ) ≠ 2]]></Calculation></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( DocumentsPath ) & $name & ".fmp12"]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$path</Name></Step>
<Step enable="True" id="132" name="Export Field Contents"><CreateDirectories state="False"/><DisableStepCollapsed state="False"/><AutoOpen state="False"/><CreateEmail state="False"/><UniversalPathList>$path</UniversalPathList><Field table="OfflineApp" id="0" name="File"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$exportError</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$exportError ≠ 0]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Download failed"]]></Calculation></Title><Message><Calculation><![CDATA["Could not save the field app to this iPad (error " & $exportError & "). If it is open, close it and try again."]]></Calculation></Message></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="111" name="Open URL"><NoInteract state="True"/><Option state="False"/><DisableStepCollapsed state="False"/><Calculation><![CDATA["fmp://~/" & $name & ".fmp12?script=" & GetAsURLEncoded ( "First Setup" ) & "&param=" & GetAsURLEncoded ( $account )]]></Calculation></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[""]]></Calculation></Step>
</Script>
</fmxmlsnippet>