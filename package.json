{
  "name": "js-dev-env",
  "version": "2.1.0",
  "author": "jeremy@integratingmagic.io",
  "license": "MIT",
  "description": "a generic development environment for developing JS in FileMaker",
  "scripts": {
    "start": "parcel index.html  --no-source-maps",
    "reload": "node ./scripts/reload-dev",
    "deploy-to-fm": "npm run build && npm run upload",
    "deploy-to-fm-live": "npm run build && node ./scripts/upload --live",
    "build": "parcel build index.html && npm run inline",
    "upload": "node ./scripts/upload",
    "generate-script-steps": "node ./scripts/generate-script-steps",
    "clear-cache": "rm -rf .parcel-cache dist",
    "reset-dev": "npm run clear-cache && npm run start",
    "start-fm-dev": "node ./scripts/start-fm-dev",
    "open-dev-browser": "open http://localhost:1234",
    "generate-initial-download": "node ./scripts/generate-initial-download",
    "generate-save-equipment-list": "node ./scripts/generate-save-equipment-list",
    "generate-get-location-detail": "node ./scripts/generate-get-location-detail",
    "generate-upload-changes": "node ./scripts/generate-upload-changes",
    "generate-sync-fields": "node ./scripts/generate-sync-fields",
    "generate-startup": "node ./scripts/generate-startup",
    "inline": "node ./scripts/inline-build",
    "generate-save-location": "node ./scripts/generate-save-location",
    "split-snippet": "node ./scripts/split-snippet",
    "generate-prepare-distribution": "node ./scripts/generate-prepare-distribution",
    "generate-probe-server-export": "node ./scripts/generate-probe-server-export",
    "generate-probe-route-file": "node ./scripts/generate-probe-route-file",
    "generate-probe-route-equipment": "node ./scripts/generate-probe-route-equipment",
    "generate-probe-install": "node ./scripts/generate-probe-install",
    "generate-build-route-export": "node ./scripts/generate-build-route-export",
    "generate-import-route": "node ./scripts/generate-import-route",
    "generate-test-import-route": "node ./scripts/generate-test-import-route",
    "generate-first-setup": "node ./scripts/generate-first-setup",
    "generate-download-offline-app": "node ./scripts/generate-download-offline-app",
    "generate-test-app-state": "node ./scripts/generate-test-app-state",
    "generate-test-web-viewer": "node ./scripts/generate-test-web-viewer",
    "generate-backfill-ids": "node ./scripts/generate-backfill-ids",
    "generate-dedupe-ids": "node ./scripts/generate-dedupe-ids",
    "generate-ui-download-script": "node ./scripts/generate-ui-download-script"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "devDependencies": {
    "eslint": "^8.16.0",
    "eslint-config-prettier": "^8.5.0",
    "open": "^8.2.1",
    "parcel": "^2.8.1",
    "prettier": "2.6.2"
  }
}
